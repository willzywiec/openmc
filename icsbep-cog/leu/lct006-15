LCT006-15: Tank-Type Critical Assembly (TCA) 16x16 rods with 2.293 cm pitch; Hc=64.42 cm
basic
  neutron delayedn CM URRPT
criticality
  npart=10000 nbatch=150 sdt=0.0001 nfirst=10 norm=1. nsource=4 
  -1.1 -1.1 32.21
  -1.1  1.1 32.21
   1.1 -1.1 32.21
   1.1 -1.1 32.21
mix nlib=ENDFB8R0 ptlib=PT.ENDFB8R0.ACE sablib=T.ENDFB8R0
  mat=1 bunches u234 4.8872-6 u235 6.0830-4 u238 2.2531-2 o16 4.7214-2 $ U(2.596)O2
  mat=2 bunches   al 5.5137-2                                          $ Aluminum clad
  mat=3 bunches (h.h2o) 6.6735-2 o16 3.3368-2                          $ Water
assign-mc
  1 red 2 yellow 3 sky
geometry
   use unit 2 core    -4 -5
   sector   3 refl -3  4 -5
   boundary vacuum        5
define unit 1 $ Unit cell with one fuel rod
   sector 1 UO2 -1 -2
   sector 2 Al   1 -2
   sector 3 H2O  2 -3 -5
define unit 2 $ Array of 16x16 fuel rods with 2.293 cm pitch
   {x 101 17 [-18.344  18.344]
    y 201 17 [-18.344  18.344]
    z 301    -999.999 999.999
    fill 256*1}
picture cs material color   0  2.3  32   0   0    32   2.3 0    32 title="plane detail of one pin"
picture cs material color   0  1.1   1   0   1.1  -1   2.3 1.1  -1 title="axial detail of the bottom of one pin"
picture cs material color -50 50    32 -50 -50    32  50 -50    32 title="plane view"
picture cs material color -50  1.1 159 -50   1.1 -35  50   1.1 -35 title="axial view"
surfaces 
  1 c z  0.625                $ Fuel
  2 c z  0.7085  0.0   144.15 $ Clad
  3 p z 64.42                 $ Water critical height, Hc
  4 box 36.688  36.688 174.15 tr 0 0 57.075 $ DX=DY=16*2.293        = 36.688 (core planar bdy)
  5 box 96.688  96.688 174.15 tr 0 0 57.075 $ DX=DY=16*2.293 + 2*30 = 96.688 (refl planar bdy)
end
