LCT007-7: 217 U(4.738)O2 fuel rods with 2.26 cm triangular pitch in water
basic
  neutron delayedn CENTIMETERS URRPT
criticality
  npart=15000 nbatch=4400 sdt=0.0001 nfirst=100 norm=1.0 nsource=1
  0 0 39.75
assign-mc
  1 red 2 yellow 3 white 4 sky 5 gray
mix nlib=ENDFB8R0 ptlib=PT.ENDFB8R0.ACE sablib=T.ENDFB8R0
  mat=1 bunches    u234 7.1087-6 u235 1.1104-3 u236 3.1792-5 u238 2.2006-2 o16 4.6311-2 $ U(4.738)O2
                     al 4.1701-6   fe 9.5140-6   si 2.2479-5  b10 6.9037-8 b11 2.7788-7 $  fuel
  mat=2 bunches      al 5.9596-2   mg 3.1442-4   si 2.4894-4   zn 7.4597-6  fe 6.4052-5 $ AGS clad, plugs
  mat=3 bunches       n 4.1985-5  o16 1.1263-5                                          $ Air
  mat=4 bunches (h.h2o) 6.6706-2  o16 3.3353-2                                          $ Water
  mat=5 bunches       c 5.9414-5   cr 1.6469-2   fe 6.0014-2   mn 8.6597-4  ni 8.1061-3 $ Stainless steel
                     si 8.4696-4    s 2.2256-5  p31 3.0719-5                            $  grid, pedestal plate
geometry
    use unit 3 Core    -1  -3
    use unit 4 Refl    -1   3
    boundary   vacuum   1
 define unit 1                        $ One fuel rod in water and air
    sector   1 UO2     -1 -11 -12     $  UO2 fuel
    sector   3 Air     -1  11 -12     $  Air gap
    sector   2 AGS     -1  11  12 -13 $  AGS clad
    sector   4 Water   -1 -10  13     $  Water
    sector   3 Air     -1  10  13     $  Air
 define unit 2                                         $ Unit cell with five fuel rods
    use unit 1 Hole    -1 -14  15                      $  Fuel rod in a hole outside pedestal
    use unit 1 Hole    -1 -21  15 tr -1.957217  1.13 0 $  Fuel rod in a hole outside pedestal
    use unit 1 Hole    -1 -22  15 tr -1.957217 -1.13 0 $  Fuel rod in a hole outside pedestal
    use unit 1 Hole    -1 -23  15 tr  1.957217  1.13 0 $  Fuel rod in a hole outside pedestal
    use unit 1 Hole    -1 -24  15 tr  1.957217 -1.13 0 $  Fuel rod in a hole outside pedestal
    sector   5 SS      -1     -15                             $  SS pedestal plate
    sector   5 SS      -1  14 -16  21  22  23  24             $  SS bottom grid plate
    sector   5 SS      -1  14 -17  21  22  23  24             $  SS upper grid plate
    sector   4 Water   -1 -10  14  15  16  17  21  22  23  24 $  Water outide the holes
    sector   3 Air     -1  10  14  15  16  17  21  22  23  24 $  Air outside the holes
 define unit 3 $ 9x17 array with 2.26 cm triangular pitch
   {x 101 10 [-17.614953  17.614953]
    y 201 18 [-19.21      19.21]
    z 301    -999.99    999.99
    fill
    153*2}
  define unit 4 $ reflector
    sector   3 Air     -1  10
    sector   4 Water   -1 -10  15
    sector   5 SS      -1 -10 -15
  picture cs material color -22  22  45   -22 -22  45  22 -22   45 title="plane view at fuel midplane"
  picture cs material color -22  22  96.5 -22 -22 96.5 22 -22 96.5 title="plane view through upper grid plate"
  picture cs material color -22  22  -0.1 -22 -22 -0.1 22 -22 -0.1 title="plane view through lower grid plate"
  picture cs material color   0 -22  99     0 -22 -22   0  22  -22 title="axial y-z view of entire geometry"
  picture cs material color -1    0  99    -1   0  87   1   0   87 title="axial x-z detail of the upper part of the fuel rod"
  picture cs material color -1    0   1    -1   0  -3   1   0   -3 title="axial x-z detail of the lower part of the fuel rod"
surfaces
$ --- Entire problem
   1 box  120.0  120.0  120.0 tr 0 0 38.2 $ Entire problem (BCD)
   2 prism 6  15.657736  9.04   0  18.08  -15.657736  9.04   $ Hexagonal
             -15.657736 -9.04   0 -18.08   15.657736 -9.04   $  lattice boundary
              tr 0 0 0 0 0 1 1 0 0                           $  through rod centers
   3 prism 6  16.636345  9.605  0  19.21  -16.636345  9.605  $ Hexagonal
             -16.636345 -9.605  0 -19.21   16.636345 -9.605  $  lattice boundary
              tr 0 0 0 0 0 1 1 0 0                           $  between rod centers
$ --- Unit cell with one fuel rod
  10 p z   79.50                          $ Hc
  11 c z    0.3946 0.0   89.7             $ UO2
  12 c z    0.41   0.0   96.9             $ Gap
  13 rev 3 -1.8 0.0 -1.0 0.47 98.2 0.47   $ AGS
     tr 0 0 0 0 0 1 0 1 0                 $  clad
  14 c z    0.50                          $ Hole in grid plates
  15 box   95.0   95.0    0.8 tr 0 0 -2.2 $ SS pedestal plate
  16 c z  999.9   -0.3   -0.05            $ SS bottom grid plate
  17 c z  999.9   96.45  96.7             $ SS upper grid plate
$ --- Four other hole positions    
  21 c z    0.50 tr -1.957217  1.13 0 $ Hole in grid plates
  22 c z    0.50 tr -1.957217 -1.13 0 $ Hole in grid plates
  23 c z    0.50 tr  1.957217  1.13 0 $ Hole in grid plates
  24 c z    0.50 tr  1.957217 -1.13 0 $ Hole in grid plates
end
