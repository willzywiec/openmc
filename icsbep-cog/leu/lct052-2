LCT052-2: Hexagonal array of 1261 U(4.738)O2 fuel rods with 1.72 cm triangular pitch in gadolinium nitrate solution
basic
  neutron delayedn CENTIMETERS URRPT
criticality
  npart=15000 nbatch=4400 sdt=0.0001 nfirst=100 norm=1.0 nsource=1
  0 0 44.25
assign-mc
  1 red 2 yellow 3 gray 4 sky
mix nlib=ENDFB8R0 ptlib=PT.ENDFB8R0.ACE sablib=T.ENDFB8R0
  mat=1 bunches    u234 7.1318-6 u235 1.1104-3 u236 3.1838-5 u238 2.2006-2 o16 4.6391-2 $ U(4.738)O2
  mat=2 bunches      al 5.9569-2   mg 3.1442-4   si 2.4894-4   fe 6.4052-5  zn 7.4597-6 $ AGS clad, plugs
  mat=3 bunches      fe 5.8694-2   cr 1.6469-2   ni 8.1061-3   mn 1.7319-3  si 1.6939-3 $ Stainless steel
                      c 1.1883-4    p 6.1438-5    s 4.4504-5                            $  grid, pedestal plate
  mat=4 bunches      gd 1.64674-6   n 8.85459-6 (h.h2o) 6.66940-2 o16 3.33716-2         $ Gadolinium nitrate solution
geometry
    use unit 3 Core    -1 -99
    use unit 4 Refl    -1  99
    boundary   vacuum   1
define  unit 1 $ Fuel rod
    sector   1 UO2    -11 -12         $  UO2 fuel
    sector   0 Void    11 -12         $  Air gap
    sector   2 AGS     11  12 -13 -20 $  AGS clad
    sector   4 Soln    -5  13 -20     $  Solution
define unit  2 $ Unit cell with one full and six half holes with 1.72 cm triangular pitch
    use unit 1 Hole   -20
    use unit 1 Hole   -21 tr -0.86  1.489564 0
    use unit 1 Hole   -22 tr  0.86  1.489564 0
    use unit 1 Hole   -23 tr -1.72  0        0
    use unit 1 Hole   -24 tr  1.72  0        0
    use unit 1 Hole   -25 tr -0.86 -1.489564 0
    use unit 1 Hole   -26 tr  0.86 -1.489564 0
    use unit 4 Refl -1 20 21 22 23 24 25 26
define unit 3 $ 21x21 array with 3.44 x 2.9791274 cm square pitch
   {x 101 22 [-36.12      36.12]
    y 201 22 [-31.280838  31.280838]
    z 301    -999.99 999.99
    fill
    441*2}
define unit  4 $ Reflector
   sector    4 Soln    -1 2 3 4 -5
   sector    3 Support -2
   sector    3 Grid    -3
   sector    3 Grid    -4
  picture cs material color -50  50  96.6 -50 -50 96.6  50 -50  96.6 title="plane view through upper grid plate"
  picture cs material color -50  50  40   -50 -50  40   50 -50  40   title="plane view of fuel in solution"
  picture cs material color -50  50  -0.2 -50 -50  -0.2 50 -50  -0.2 title="plane view through lower grid plate"
  picture cs material color -50   0  99   -50   0 -25   50   0 -25   title="axial x-z view of entire geometry"
  picture cs material color  -1   0  99   -1    0  87    1   0  87   title="axial x-z detail of the upper part of the fuel rod"
  picture cs material color  -1   0   1   -1    0  -3    1   0  -3   title="axial x-z detail of the lower part of the fuel rod"
surfaces
$ --- Entire problem
   1 box  120.0   120.0  120.0  tr 0 0 40.0   $ Entire problem (BCD)
   2 box   95.0    95.0    0.8  tr 0 0 -2.2   $ Support plate
   3 box   72.0    72.0    0.25 tr 0 0 -0.175 $ Lower grid plate
   4 box   72.0    72.0    0.25 tr 0 0 96.575 $ Upper grid plate
   5 p z   88.5                               $ Solution critical height
  99 prism 6 35.26 0  17.63  30.53605 -17.63  30.53605 $ Lattice
            -35.26 0 -17.63 -30.53605  17.63 -30.53605 $  core 
             tr 0 0 0 0 0 1 1 0 0                      $  boundary
$ --- Unit with one fuel rod in one hole
  11 c z    0.395   0.0   90.0          $ UO2
  12 c z    0.41    0.0   96.9          $ Gap
  13 rev 3 -1.8 0.0 -1.0 0.47 98.2 0.47 $ AGS
     tr 0 0 0 0 0 1 0 1 0               $  clad
$ --- Unit lattice cell                    
  20 c z    0.50   -1.8   98.2                      $ Hole
  21 c z    0.50   -1.8   98.2 tr -0.86  1.489564 0 $ Hole
  22 c z    0.50   -1.8   98.2 tr  0.86  1.489564 0 $ Hole
  23 c z    0.50   -1.8   98.2 tr -1.72  0        0 $ Hole
  24 c z    0.50   -1.8   98.2 tr  1.72  0        0 $ Hole
  25 c z    0.50   -1.8   98.2 tr -0.86 -1.489564 0 $ Hole
  26 c z    0.50   -1.8   98.2 tr  0.86 -1.489564 0 $ Hole
end
