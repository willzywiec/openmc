LCT006-13: Tank-Type Critical Assembly (TCA) 20x20 rods with 2.15 cm pitch; Hc=40.44 cm
basic
  neutron delayedn CM URRPT
criticality
  npart=15000 nbatch=4400 sdt=0.0001 nfirst=100 norm=1. nsource=4 
  -1.1 -1.1 20.22
  -1.1  1.1 20.22
   1.1 -1.1 20.22
   1.1  1.1 20.22
mix nlib=ENDFB8R0 ptlib=PT.ENDFB8R0.ACE sablib=T.ENDFB8R0
  mat=1 bunches u234 4.8872-6 u235 6.0830-4 u238 2.2531-2 o16 4.7214-2 $ U(2.596)O2
  mat=2 bunches   al 5.5137-2                                          $ Aluminum clad
  mat=3 bunches (h.h2o) 6.6735-2 o16 3.3368-2                          $ Water
assign-mc
  1 red 2 yellow 3 sky
geometry
   use unit 2 core    -4 -5
   sector   3 refl -3  4 -5
   boundary vacuum        5
define unit 1 $ Unit cell with one fuel rod
   sector 1 UO2 -1 -2
   sector 2 Al   1 -2
   sector 3 H2O  2 -3 -5
define unit 2 $ Array of 20x20 fuel rods with 2.15 cm pitch
   {x 101 21 [-21.5  21.5]
    y 201 21 [-21.5  21.5]
    z 301    -999.9 999.9 
    fill 400*1}
picture cs material color  -2  2    20  -2  -2    20   2  -2    20 title="plane detail of one pin"
picture cs material color  -2  1.1   1  -2   1.1  -1   2   1.1  -1 title="axial detail of the bottom of one pin"
picture cs material color -55 55    20 -55 -55    20  55 -55    20 title="plane view"
picture cs material color -55  1.1 159 -55   1.1 -35  55   1.1 -35 title="axial view"
surfaces 
  1 c z   0.625               $ Fuel
  2 c z   0.7085 0.0   144.15 $ Clad
  3 p z  40.44                $ Water critical height, Hc
  4 box  43.00  43.00  174.15 tr 0 0 57.075 $ DX=DY=20*2.15        =  43.00 (core planar bdy)
  5 box 103.00 103.00  174.15 tr 0 0 57.075 $ DX=DY=20*2.15 + 2*30 = 103.00 (refl planar bdy)
end
