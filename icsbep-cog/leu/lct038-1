LCT038-1: Two (18x13-2) arrays of U(4.738)O2 rods, 1.60 cm pitch, no concrete reflector, Hc=71.2cm
basic
  neutron delayedn CENTIMETERS URRPT
criticality
  npart=10000 nbatch=150 sdt=0.0001 nfirst=10 norm=1.0 nsource=26
    -0.8  0.8 35.6  -0.8 -0.8 35.6
    -2.4  0.8 35.6  -2.4 -0.8 35.6
    -4.0  0.8 35.6  -4.0 -0.8 35.6
    -5.6  0.8 35.6  -5.6 -0.8 35.6
    -7.2  0.8 35.6  -7.2 -0.8 35.6
    -8.8  0.8 35.6  -8.8 -0.8 35.6
   -10.4  0.8 35.6 -10.4 -0.8 35.6
   -12.0  0.8 35.6 -12.0 -0.8 35.6
   -13.6  0.8 35.6 -13.6 -0.8 35.6
   -15.2  0.8 35.6 -15.2 -0.8 35.6
   -16.8  0.8 35.6 -16.8 -0.8 35.6
   -18.4  0.8 35.6 -18.4 -0.8 35.6
   -20.0  0.8 35.6 -20.0 -0.8 35.6
assign-mc
  1 red 2 yellow 3 gray 4 white 5 sky
mix nlib=ENDFB8R0 ptlib=PT.ENDFB8R0.ACE sablib=T.ENDFB8R0
  mat=1 bunches    u234 7.1318-6  u235 1.1104-3  u236 3.1838-5  u238 2.2006-2   o16 4.6392-2 $ U(4.738)O2
                    b10 5.7531-8   b11 2.3157-7                                              $  fuel
  mat=2 bunches      al 5.9569-2    mg 3.1442-4    si 2.4894-4    fe 6.4052-5    zn 7.4597-6 $ AGS clad, plugs
  mat=3 bunches       c 1.1883-4    cr 1.6469-2    fe 5.8694-2    mn 1.7319-3    ni 8.1061-3 $ Stainless steel
                     si 1.6939-3     p 6.1438-5     s 4.4504-5                               $   Z2 CN18/10
  mat=4 bunches       n 4.1985-5   o16 1.1263-5                                              $ Air
  mat=5 bunches (h.h2o) 6.6722-2   o16 3.3361-2                                              $ Water, cases 1 & 4
geometry
   use unit 3 Assy  -10      12 -14  21  22  32 tr -14.4  14.4 0 $ Basket assembly
   use unit 3 Assy   10 -11  12 -14  23  24  34 tr -14.4 -14.4 0 $ Basket assembly
     sector 3 SST   -10      12 -14 -21 $ Tie rod
     sector 3 SST   -10      12 -14 -22 $ Tie rod
     sector 3 SST    10 -11  12 -14 -23 $ Tie rod
     sector 3 SST    10 -11  12 -14 -24 $ Tie rod
     sector 4 Air   -10      12 -14  21  22 -31 -32 $ Instrument thimble, air
     sector 3 SST   -10      12 -14  21  22  31 -32 $ Instrument thimble, steel
     sector 4 Air    10 -11  12 -14  23  24 -33 -34 $ Instrument thimble, air
     sector 3 SST    10 -11  12 -14  23  24  33 -34 $ Instrument thimble, steel
$ --- Pedestal support plate and water
     sector 3 SST        10  11 -12 -13 -14 $ Pedestal support plate
     sector 3 SST                   -13  14 $ Tank
     sector 4 Air     5  10  11  12 -13 -14 $ Air   within the tank
     sector 5 Water  -5  10  11  12 -13 -14 $ Water within the tank
     boundary vacuum 13
define unit 1 $ Unit cell with one fuel rod, grid plates, water, etc.
   sector   1 UO2     -1 -2    $ UO2 fuel
   sector   4 Air      1 -2    $ Air in gap
   sector   2 AGS      1  2 -3 $ AGS clad
   sector   4 Air      3 -4  5 $ Air in hole
   sector   5 Water    3 -4 -5 $ Water in hole
   sector   3 Steel    4 -6    $ Upper grid plate
   sector   3 Steel    4 -7    $ Lower grid plate
   sector   3 Basket   8 -9    $ Basket
   sector   4 Air      4  5  6  7 -8 -9 $ Air
   sector   5 Water    4 -5  6  7 -8 -9 $ Water
define unit 2 $ Unit cell with no fuel rod, grid plates, water, etc.
   sector   4 Air     -4  5 $ Air in hole
   sector   5 Water   -4 -5 $ Water in hole
   sector   3 Steel    4 -6 $ Upper grid plate
   sector   3 Steel    4 -7 $ Lower grid plate
   sector   3 Basket   8 -9 $ Basket
   sector   4 Air      4  5  6  7 -8 -9 $ Air
   sector   5 Water    4 -5  6  7 -8 -9 $ Water
define unit 3 $ 18x18 array with 1.60 cm square pitch
   {x 101 19 [-14.4  14.4]
    y 121 19 [-14.4  14.4]
    z 141    -999.9 999.9
    fill 
    5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1
    5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1 
    5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1 5*2 13*1}
