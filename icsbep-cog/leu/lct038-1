picture cs material color res=1500 -125  65    30   -125 -65    30   20 -65    30   title="plane view through the water"
picture cs material color res=1500 -125  65    -0.2 -125 -65    -0.2 20 -65    -0.2 title="plane view through lower grid plate"
picture cs material color res=1500 -125  65    -3   -125 -65    -3   20 -65    -3   title="plane view through pedestal support plate"
picture cs material color res=1500  -20  20    -0.2  -20 -20    -0.2 20 -20    -0.2 title="plane detail of lower grid plate center"
picture cs material color res=1500 -125   0.8 105   -125   0.8 -25   20   0.8 -25   title="axial x-z view of entire geometry"
picture cs material color res=1500   10 -28   105     10 -28    80   20 -28    80   title="axial x-z detail of the upper baskets, rhs"
picture cs material color res=1500   10 -28    25     10 -28   -10   20 -28   -10   title="axial x-z detail of the lower baskets, rhs"
picture cs material color res=1500  -20 -28   105    -20 -28    80  -10 -28    80   title="axial x-z detail of the upper baskets, hs"
picture cs material color res=1500  -20 -28    25    -20 -28   -10  -10 -28   -10   title="axial x-z detail of the lower baskets, lrhs"
surfaces
$ --- Unit with one fuel rod in one hole with grid plates in water
   1 c z   0.395  0.0   90.0 $ UO2
   2 c z   0.410  0.0   96.9 $ Gap
   3 rev 3 -1.8   0.0   -1.0   0.470   98.2   0.470 tr 0 0 0 0 0 1 0 1 0 $ AGS
   4 c z   0.50  -1.8   98.2 $ Hole
   5 p z  71.2               $ Critical water height
   6 box  28.8   28.8    0.2 tr 0 0 -0.2 $ Lower grid plate
   7 box  28.8   28.8    0.2 tr 0 0 96.7 $ Upper grid plate
   8 box  28.8   28.8  105.2 tr 0 0 50.8 $ Basket, inner
   9 box  28.8   28.8  106.8 tr 0 0 50.8 $ Basket, outer
