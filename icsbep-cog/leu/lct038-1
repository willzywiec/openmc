  31 c z   0.7975            tr -27.8675  27.8675 0 $ Inner
  32 c z   0.9325 -1.8 104.2 tr -27.8675  27.8675 0 $ Outer
  33 c z   0.7975            tr -27.8675 -27.8675 0 $ Inner
  34 c z   0.9325 -1.8 104.2 tr -27.8675 -27.8675 0 $ Outer
