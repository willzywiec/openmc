LCT027-1: 14x14 array reflected by lead with no water gap
basic
  neutron delayedn CENTIMETERS URRPT
criticality
  npart=10000 nbatch=150 sdt=0.0001 nfirst=10 norm=1.0 nsource=4
  -0.8 -0.8 37.565
   0.8 -0.8 37.565
  -0.8  0.8 37.565
   0.8  0.8 37.565
mix nlib=MCNP.80nc ptlib=PT.MCNP.80nc sablib=T.MCNP.80
  mat=1 bunches    u234 7.1087-6 u235 1.1104-3 u236 3.1792-5 u238 2.2006-2 o16 4.6311-2 $ UO2
                     al 4.1701-6   fe 9.5140-6   si 2.2479-5  b10 6.9037-8 b11 2.7788-7 $  fuel
  mat=2 bunches      al 5.9569-2   mg 3.1442-4   si 2.4894-4   zn 7.4597-6  fe 6.4052-5 $ AGS clad & plugs
  mat=3 bunches (h.h2o) 6.6706-2  o16 3.3353-2                                          $ Water
  mat=4 bunches      fe 8.4489-2    c 2.3765-4   mn 3.4639-4    s 4.4509-5  si 5.0818-4 $ Mild steel
                      p 4.6079-5                                                        $  pedestal support plate
  mat=5 bunches      fe 6.0014-2   cr 1.6469-2   ni 8.1061-3   mn 8.6597-4  si 8.4696-4 $ Stainless steel
                      c 5.9414-5    s 2.2256-5    p 3.0719-5                            $  basket
  mat=6 bunches      pb 3.2515-2                                                        $ Lead
  mat=7 bunches       n 4.1985-5  o16 1.1265-5                                          $ Air
  mat=8 bunches (h.h2o) 8.0848-3  o16 4.0424-3   fe 5.2741-2   cr 1.4473-2  ni 7.1236-3 $ Basket bottom plate 
assign-mc
  1 red 2 yellow 3 sky 4 black 5 gray 6 brown 7 pink 8 green
geometry
$ --- Above the pedestal support plate
    use unit 2 Core   -2  3 4 5 6 7 8 9 10 20 22 -99 $ 14x14 array of fuel pins
    sector   5 Angl   -2 -3 or -2  3 -7  $ Angled corner
    sector   5 Angl   -2 -4 or -2  4 -8  $ Angled corner
    sector   5 Angl   -2 -5 or -2  5 -9  $ Angled corner
    sector   5 Angl   -2 -6 or -2  6 -10 $ Angled corner
    sector   5 Sppt   -2 -20             $ Support rod
    sector   7 Air     1  2  22 25 26 27 28 -99 $ Air   outside core, lead, and above support plate    
    sector   3 H2O    -1  2  22 25 26 27 28 -99 $ Water outside core, lead, and above support plate
   sector    6 Lead    2 22 -25 or 2 22 -26 or 2 22 -27 or 2 22 -28 $ Lead reflectors #1-4
$ --- Beneath the pedestal support plate
    sector   3 H2O   -21 -22  23 -99 $ Hole in pedestal support plate
    sector   4 Mild   21 -22  23 -99 $ Mild steel pedestal support plate
    sector   3 H2O           -23 -99 $ Water beneath pedestal support plate 
    boundary vacuum   99             $ Boundary condition 
define unit 1                               $ Unit cell with fuel rod
    sector   1 UO2      -11 -12             $   UO2 fuel
    sector   7 Air       11 -12             $   Air gap
    sector   2 AGS       11  12 -13         $   AGS clad
    sector   3 H2O               13 -14 -16 $   Water in the lower grid hole
    sector   7 Air               13 -14 -17 $   Air   in the upper grid hole
    sector   8 BskPlt    13 -15             $   Basket bottom plate
    sector   5 SST       14 -16             $   Lower grid plate
    sector   5 SST       14 -17             $   Upper grid plate
    sector   5 SST      -18                 $   Top plate
    sector   3 H2O   -1  13  15  16  17  18 $   Water
    sector   7 Air    1  13  15  16  17  18 $   Air
define unit 2 $ 14x14 array, 1.6 cm pitch
   {x 101 15 [-11.2  11.2]
    y 121 15 [-11.2  11.2]
    z 141    -999.9 999.9
    fill 196*1}
  picture cs material color   0 1.6  96.5   0   0 96.5 1.6   0 96.5 title="plane detail of one rod in upper grid"
  picture cs material color   0 1.6   0.8   0   0  0.8 1.6   0  0.8 title="plane detail of one rod in lower grid"
  picture cs material color -12  12  96.5 -12 -12 96.5  12 -12 96.5 title="plane detail of upper grid"
  picture cs material color -12  12  50   -12 -12 50    12 -12 50   title="plane detail in water"
  picture cs material color -12  12   0.8 -12 -12  0.8  12 -12  0.8 title="plane detail of lower grid"
  picture cs material color -60  60   0.8 -60 -60  0.8  60 -60  0.8 title="plane view"
  picture cs material color -12 0.8 105   -12 0.8   -5  12 0.8   -5 title="axial x-z detail"
  picture cs material color -12  12 105   -12  12   -5  12 -12   -5 title="axial detail on diagonal"
  picture cs material color -60  60 105   -60  60  -25  60 -60  -25 title="axial view on diagonal"
surfaces
$ --- Geometry outside the array boundary
   1 p z  75.13                                        $ Critical height
   2 box  22.4      22.4     999.9                     $ Array boundary
   3 box   4.0       0.4     106.6 tr -11.2 -11.2 50.1 $ Angled corner
   4 box   4.0       0.4     106.6 tr  11.2 -11.2 50.1 $ Angled corner
   5 box   4.0       0.4     106.6 tr -11.2  11.2 50.1 $ Angled corner
   6 box   4.0       0.4     106.6 tr  11.2  11.2 50.1 $ Angled corner
   7 box   0.4       4.0     106.6 tr -11.2 -11.2 50.1 $ Angled corner
   8 box   0.4       4.0     106.6 tr  11.2 -11.2 50.1 $ Angled corner
   9 box   0.4       4.0     106.6 tr -11.2  11.2 50.1 $ Angled corner
  10 box   0.4       4.0     106.6 tr  11.2  11.2 50.1 $ Angled corner
$ --- Unit cell with fuel rod
  11 c z   0.3946    0.0      89.7  $ UO2
  12 c z   0.41      0.0      96.9  $ Air
  13 rev 3 -1.8 0.0 -1.0 0.47 98.2 0.47 tr 0 0 0 0 0 1 0 1 0 $ Clad
  14 c z   0.50     -1.8      98.2  $ Hole
  15 box 999.9     999.9       0.4 tr 0 0  -2.0 $ Basket bottom plate
  16 box 999.9     999.9       0.2 tr 0 0   0.8 $ Lower grid plate
  17 box 999.9     999.9       0.2 tr 0 0  96.5 $ Upper grid plate
  18 box 999.9     999.9       0.4 tr 0 0 103.6 $ Top plate
$ --- The rest
  20 c z   0.3      46.8     103.4 $ Source support rod
  21 c z   4.2215                  $ Hole in the mild steel pedestal support plate
  22 p z  -3.2                     $ Top of the pedestal support plate
  23 p z  -4.2                     $ Top of the pedestal support plate
  25 box  60.0      30.0      95.0 tr -18.8 -26.2 44.3 $ Lead #1 
  26 box  60.0      30.0      95.0 tr  18.8  26.2 44.3 $ Lead #2
  27 box  30.0      60.0      95.0 tr -26.2  18.8 44.3 $ Lead #3
  28 box  30.0      60.0      95.0 tr  26.2 -18.8 44.3 $ Lead #4
  99 box 118.0     118.0     126.0 tr   0     0   40.8 $ BCD
end
