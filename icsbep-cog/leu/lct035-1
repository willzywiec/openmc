LCT035-1: 21x21 array of U(2.6)O2 rods on 1.956cm pitch in soluble boron (TCA Core B1)
basic
  neutron delayedn CENTIMETERS URRPT
criticality
  npart=10000 nbatch=150 sdt=0.0001 nfirst=10 norm=1.0 nsource=1
   0 0 26.17
mix nlib=ENDFB8R0 ptlib=PT.ENDFB8R0.ACE sablib=T.ENDFB8R0
  mat=1 bunches    u234 4.8872-6 u235 6.0830-4 u238 2.2531-2 o16 4.7214-2 $ U(2.60)O2 fuel
  mat=2 bunches      al 5.5137-2                                          $ Al+Air (homogenized) clad
  mat=3 bunches      al 6.0224-2                                          $ Al end plug, grid & support plates
  mat=4 bunches (h.h2o) 6.6652-2  o16 3.3332-2  b10 7.7376-7 b11 3.1145-6 $ Water with soluble boron (B1)
  mat=5 bunches       c 1.1928-4   si 1.7003-3   mn 1.7385-3   p 6.9381-5 $ SS304L
                      s 4.4673-5   ni 8.9506-3   cr 1.7450-2  fe 5.7202-2 $  support plate & core tank
  mat=6 bunches (h.h2o) 1.3742-2  o16 4.5919-2    c 1.1532-4  na 9.6395-4 $ Ordinary
                     mg 1.2388-4   al 1.7409-3   si 1.6617-2   k 4.6052-4 $  concrete
                     ca 1.5025-3   fe 3.4492-4                            $  floor
assign-mc
  1 black 2 lime 3 yellow 4 sky 5 gray 6 brown
geometry
    use unit 3 Core   -2 -8
    use unit 1 Refl    2 -8
    boundary   vacuum     8
 define unit 1                           $ Geometry outside the array
    sector   3 Al      -3             -8 $   Al lower grid plate
    sector   3 Al6061  -4             -8 $   Al lower support plate
    sector   5 SS304L   4 -5          -8 $   SS304L lower plate
    sector   4 H2O     -1  3  4  5  7 -8 $   Water
    sector   6 Cncrt   -1  3  4  5 -7 -8 $   Concrete
 define unit 2                       $ Unit cell with fuel rod
    sector   1 UO2    -11 -12  13    $   UO2 pellet
    sector   2 Clad    11 -12  13    $   Al and air homogenized clad
    sector   3 Al      11  12 -13    $   Al end plug
    use unit 1 Alles   11  12  13 -8 $   Al and SS304L plates, and water 
 define unit 3 $ 21x21 array
   {x 101 22 [-20.538  20.538]
    y 131 22 [-20.538  20.538]
    z 161    -999.9   999.9
    fill 441*2}
  picture cs material color          -55  55    5 -55  -55   5  55  -55   5 title="plane view in water"
  picture cs material color           -1   5    5  -1   -1   5   5   -1   5 title="plane detail of 6 rods in water"
  picture cs material color res=1500 -55   0  145 -55    0 -75  55    0 -75 title="axial x-z view"
  picture cs material color res=1500   0   0    5   0    0 -25  30    0 -25 title="axial x-z detail"
surfaces
$ --- Geometry outside the array boundary
   1 p z  52.14                                  $ Critical height
   2 box  41.076   41.076  999.99                $ Array boundary
   3 box 999.9    999.9      0.6  tr 0 0 -12.085 $ Al lower grid
   4 box 999.9    999.9      1.27 tr 0 0 -17.465 $ Al support plate
   5 box 999.9    999.9      2.2  tr 0 0 -19.200 $ SS304L lower plate
   6 box 101.076  101.076 215.75  tr 0 0  36.275 $ Entire problem (BCD)
   7 p z -34.6                                   $ Top of concrete
   8 box 999.9    999.9   999.9                  $ Dummy
$ --- Fuel rod
  11 c z  0.6250    0.0    144.15 $ UO2 pellet
  12 c z  0.7085    0.0    144.15 $ Al+Air homogenized clad and gap
  13 c z  0.7085  -16.83     0.0  $ Al end plug
end
