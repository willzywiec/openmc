MIX-COMP-THERM-003-4: 13x13 lattice of MOX pins with SQRT(2) * 1.3208 cm = 1.8679 cm pitch; Hw=114.285
basic
  neutron delayedn CENTIMETERS URRPT
criticality
  npart=10000 nbatch=150 sdt=0.0001 nfirst=10 norm=1. nsource=1
  0 0 80.08
dump 1400 2400 3400 4400
mix nlib=ENDFB8R0 ptlib=PT.ENDFB8R0.ACE sablib=T.ENDFB8R0     
  mat=1 bunches   pu239 1.3526-3 pu240 1.2759-4 pu241 1.1407-5 pu242 6.0318-7 am241 1.7783-6 $ PuO2-UO2
                   u234 1.1688-6  u235 1.5301-4  u238 2.1097-2   o16 4.5155-2                $   fuel
  mat=2 bunches      sn 4.6590-4    fe 1.4148-4    cr 7.5977-5   o16 2.9630-4    zr 4.2517-2 $ Clad and plugs
  mat=3 bunches (h.h2o) 6.6673-2   o16 3.3336-2                                              $ Water, case 4
  mat=4 bunches      al 6.0039-2                                                             $ Grid and support plates, and slab
assign-mc
  1 red 2 gray 3 sky 4 yellow
geometry
  use unit 6 lttc -14       426
  use unit 5 lttc -14  401 -426
  use unit 4 lttc -14 -401
  boundary vacuum  14 
define unit 1 $ Fuel rod
  sector 1 MOX     -1 -2
  sector 0 Gap2     1 -2
  sector 2 Clad     2 -99
define unit 2 $ Empty unit cell
  sector 4 Al      -4                     -99 $ Al slab
  sector 4 Al      -5                     -99 $ Al plate
  sector 4 Al       5  -6   9             -99 $ Al bottom grid plate with one fuel rod hole
  sector 4 Al      -7   9  10  11  12  13 -99 $ Al middle grid plate with one fuel rod hole and four circulation holes
  sector 4 Al      -8   9                 -99 $ Al top    grid plate with one fuel rod hole
  sector 3 H2O     -6  -9                 -99 $ Water filled fuel  hole in bottom grid plate
  sector 3 H2O     -7  -9                 -99 $ Water filled fuel  hole in middle grid plate
  sector 3 H2O     -7 -10                 -99 $ Water filled circ. hole in middle grid plate
  sector 3 H2O     -7 -11                 -99 $ Water filled circ. hole in middle grid plate
  sector 3 H2O     -7 -12                 -99 $ Water filled circ. hole in middle grid plate
  sector 3 H2O     -7 -13                 -99 $ Water filled circ. hole in middle grid plate
  sector 3 H2O      4   5   6   7   8 -15 -99 $ Water elsehwere
define unit 3 $ Unit cell with fuel rod
  use unit 1 furod -3 -99                     $ MOX fuel rod 
  use unit 2 norod  3 -99                     $ Everything else
